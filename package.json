{
  "name": "codelight",
  "version": "0.5.8",
  "private": true,
  "type": "module",
  "description": "CodeLight native mobile access to existing Codex desktop sessions",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "security:release": "node scripts/audit-public-release.mjs",
    "start": "node scripts/codelight-daemon.mjs",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src scripts test public",
    "verify": "npm run typecheck && npm run lint && npm test",
    "package": "node scripts/package-codelight.mjs",
    "start:legacy": "node scripts/launch.mjs",
    "package:codelight": "node scripts/package-codelight.mjs",
    "package:source": "node scripts/package-codelight.mjs --source-only",
    "postinstall": "node scripts/postinstall.cjs",
    "typecheck:mobile": "pnpm --filter @codelight/mobile typecheck",
    "typecheck:relay": "pnpm --filter @codelight/relay typecheck:prod",
    "typecheck:all": "pnpm typecheck && pnpm typecheck:mobile && pnpm typecheck:relay",
    "dev:mobile": "pnpm --filter @codelight/mobile start",
    "build:mac": "node scripts/build-mac-app.mjs",
    "build:mobile": "node scripts/build-mobile.mjs",
    "build:native": "sh native/build.sh"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "eslint": "9.39.5",
    "happy-dom": "21.0.4",
    "typescript": "5.9.3",
    "esbuild": "0.27.2"
  },
  "dependencies": {
    "@slopus/happy-wire": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "proper-lockfile": "4.1.2",
    "socket.io-client": "4.8.4",
    "tweetnacl": "1.0.3",
    "ws": "8.22.0",
    "qrcode-terminal": "0.12.0"
  },
  "packageManager": "pnpm@10.11.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mapix/CodeLight.git"
  }
}
